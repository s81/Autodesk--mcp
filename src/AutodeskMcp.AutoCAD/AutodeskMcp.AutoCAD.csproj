<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Build one AutoCAD year at a time:
      dotnet build src/AutodeskMcp.AutoCAD -c Release -p:AutoCADVersion=2025   (R25.0, net8.0-windows)
      dotnet build src/AutodeskMcp.AutoCAD -c Release -p:AutoCADVersion=2026   (R25.1, net8.0-windows)
      dotnet build src/AutodeskMcp.AutoCAD -c Release -p:AutoCADVersion=2027   (R26.0, net10.0-windows)
    Works in AutoCAD and its verticals (Civil 3D, Plant 3D, Map 3D, Advance Steel, ...) of the same release.
    Not AutoCAD LT (no .NET API).
  -->
  <PropertyGroup>
    <TargetFramework Condition="'$(AutoCADVersion)' == '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(AutoCADVersion)' != '2027'">net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AutodeskMcp.AutoCAD</AssemblyName>
    <RootNamespace>AutodeskMcp.AutoCAD</RootNamespace>
    <DefineConstants>$(DefineConstants);ACAD$(AutoCADVersion)</DefineConstants>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\AutoCAD$(AutoCADVersion)\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      25.0.2 / 25.1.1 were republished targeting net10.0; 25.0.1 / 25.1.0 match the .NET 8 runtime that
      AutoCAD 2025/2026 document. A net8.0 add-in also loads on a .NET 10 host.
    -->
    <AutoCADApiPackageVersion Condition="'$(AutoCADVersion)' == '2025'">25.0.1</AutoCADApiPackageVersion>
    <AutoCADApiPackageVersion Condition="'$(AutoCADVersion)' == '2026'">25.1.0</AutoCADApiPackageVersion>
    <AutoCADApiPackageVersion Condition="'$(AutoCADVersion)' == '2027'">26.0.0</AutoCADApiPackageVersion>
  </PropertyGroup>

  <Target Name="ValidateAutoCADVersion" BeforeTargets="CollectPackageReferences;Build">
    <Error Condition="'$(AutoCADApiPackageVersion)' == ''" Text="Unsupported AutoCADVersion '$(AutoCADVersion)'. Use 2025, 2026 or 2027." />
  </Target>

  <ItemGroup>
    <!-- Official Autodesk reference package; AutoCAD supplies the real assemblies at runtime. -->
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCADApiPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutodeskMcp.Bridge\AutodeskMcp.Bridge.csproj" />
  </ItemGroup>
</Project>
