<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Host-independent tests: they run without Revit/AutoCAD by standing up fake hosts (in-process, and as a
    separate process via tests/AutodeskMcp.FakeHost) and driving them through the real pipe client and the
    real MCP server process.
      net10.0 -> everywhere; includes server, cross-process and System.Text.Json compatibility tests.
      net48   -> Windows only; runs the bridge exactly as the Revit/AutoCAD 2022-2024 add-ins do.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0;net48</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutodeskMcp.Bridge\AutodeskMcp.Bridge.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\..\src\AutodeskMcp.Server\AutodeskMcp.Server.csproj" />
    <!-- Built (all of its target frameworks) but not referenced: the cross-process tests start it as a separate process. -->
    <ProjectReference Include="..\AutodeskMcp.FakeHost\AutodeskMcp.FakeHost.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Private="false" />
  </ItemGroup>
</Project>
